# Sao chép thành .env rồi điền. KHÔNG đưa file .env lên GitHub.
PORT=3000
NODE_ENV=development          # đặt "production" khi chạy thật (bật cookie Secure, bắt buộc có SMTP)

# Tài khoản Gmail dùng để GỬI mã xác minh (bật xác minh 2 bước, rồi tạo "Mật khẩu ứng dụng" 16 ký tự)
SMTP_USER=glowbase.noreply@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
# SMTP_FROM="Glow Base" <glowbase.noreply@gmail.com>

# Gmail của admin: ai đăng ký (và xác minh mã) bằng Gmail này sẽ có quyền duyệt hồ sơ
ADMIN_EMAIL=ban@gmail.com

# Chuỗi ngẫu nhiên dài (tuỳ chọn). TRUST_PROXY=1 nếu chạy sau Render/Railway/Nginx.
# APP_SECRET=
# TRUST_PROXY=1
# DATA_DIR=/var/data            # nơi lưu database + ảnh; trên hosting phải là ổ đĩa bền vững

# Số giây không thao tác thì phải đăng nhập lại (mặc định 900 = 15 phút)
# SESSION_IDLE_SEC=900
